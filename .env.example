# Copy to .dev.vars for `npm run dev` (Wrangler / vinext).
# Never commit real keys.

# Ask agent (Gemini). Without it, Ask uses the local parser and still files uploads.
# wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=

# Optional Gemini model. Default: gemini-2.5-flash
SAYPAY_GEMINI_MODEL=

# Optional. Legacy intent route still accepts this.
ANTHROPIC_API_KEY=

# Optional override. Default: claude-sonnet-4-5
SAYPAY_MODEL=

# Optional alternative to ANTHROPIC_API_KEY (Vercel AI Gateway / similar).
AI_GATEWAY_API_KEY=

# Optional. Defaults to https://rpc.nimiqwatch.com (Nimiq mainnet).
NIMIQ_RPC_URL=

# Optional. If unset, POST /api/schedules/due is 404. The Worker cron still runs.
CRON_SECRET=
