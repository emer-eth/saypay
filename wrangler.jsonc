{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saypay-payment-assistant",
  "account_id": "462e8078835e57c000346faf2dba3274",
  "workers_dev": true,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saypay-production",
      "database_id": "6d921a76-2e1e-4ec6-b37d-1bc34b33d365",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
